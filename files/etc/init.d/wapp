#!/bin/sh /etc/rc.common

START=99
STOP=10

WAPP_BIN="/usr/bin/wapp"
WAPP_NAME="wapp"
WAPP_LOG_TAG="wapp"
WAPP_PIDFILE="/var/run/wapp.pid"

start() {
    logger -t "$WAPP_LOG_TAG" "Starting WAPP service"

    # 防止重复执行 start 时再次启动实例
    if pidof "$WAPP_NAME" >/dev/null 2>&1; then
        logger -t "$WAPP_LOG_TAG" "WAPP process already exists; not starting another instance"
        return 0
    fi

    # 检查程序是否存在
    if [ ! -x "$WAPP_BIN" ]; then
        logger -t "$WAPP_LOG_TAG" "ERROR: $WAPP_BIN not found or not executable"
        return 1
    fi

    # 最多等待 60 秒，直到两个无线接口均出现
    local waited=0
    while [ ! -d /sys/class/net/ra0 ] || \
          [ ! -d /sys/class/net/rax0 ]; do
        if [ "$waited" -ge 60 ]; then
            logger -t "$WAPP_LOG_TAG" "ERROR: ra0/rax0 not ready after 60 seconds; aborting"
            return 1
        fi

        sleep 1
        waited=$((waited + 1))
    done

    # 接口出现后额外等待 2 秒
    sleep 2

    logger -t "$WAPP_LOG_TAG" "ra0/rax0 detected after ${waited}s; launching WAPP in background"

    # 清理过期 PID 文件
    rm -f "$WAPP_PIDFILE"

    # 以原厂相同的参数启动，不使用 procd respawn
    (
        export LD_LIBRARY_PATH="/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        exec "$WAPP_BIN" \
            -l br-lan -d1 -v2 \
            -f /etc/wapp_ap.conf \
            -F /etc/map/mapd_cfg \
            -u /etc/map/mapd_user.cfg \
            -K /etc/map/1905d.cfg \
            -cra0 -crax0
    ) </dev/null >/dev/null 2>&1 &

    local wapp_pid=$!
    echo "$wapp_pid" > "$WAPP_PIDFILE"

    # 简单检查进程是否立即退出
    sleep 1
    if ! kill -0 "$wapp_pid" 2>/dev/null; then
        rm -f "$WAPP_PIDFILE"
        logger -t "$WAPP_LOG_TAG" "ERROR: WAPP exited immediately after launch"
        return 1
    fi

    logger -t "$WAPP_LOG_TAG" "WAPP launched in background; launcher PID=$wapp_pid"
    return 0
}

stop() {
    logger -t "$WAPP_LOG_TAG" "Stopping WAPP service"

    # 先发送 SIGTERM，等待最多 5 秒
    killall -15 "$WAPP_NAME" 2>/dev/null

    local waited=0
    while pidof "$WAPP_NAME" >/dev/null 2>&1 && \
          [ "$waited" -lt 5 ]; do
        sleep 1
        waited=$((waited + 1))
    done

    # 仍有进程时发送 SIGKILL
    if pidof "$WAPP_NAME" >/dev/null 2>&1; then
        logger -t "$WAPP_LOG_TAG" "WAPP did not exit within 5 seconds; sending SIGKILL"
        killall -9 "$WAPP_NAME" 2>/dev/null
        sleep 1
    fi

    rm -f "$WAPP_PIDFILE"

    if pidof "$WAPP_NAME" >/dev/null 2>&1; then
        logger -t "$WAPP_LOG_TAG" "ERROR: WAPP process still exists after stop"
        return 1
    fi

    logger -t "$WAPP_LOG_TAG" "WAPP stopped"
    return 0
}
