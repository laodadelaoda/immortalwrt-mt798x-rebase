#!/bin/sh /etc/rc.common

START=99
STOP=10

start() {
    # 等待系统网络和无线驱动初始化
    sleep 5
    
    # 切换到根目录并配置动态库路径
    cd /
    export LD_LIBRARY_PATH=/usr/lib
    
    # 在后台拉起 wapp，并将日志重定向到 /tmp，防止 Broken pipe 猝死
    /usr/bin/wapp -l br-lan -d1 -v2 \
        -f /etc/wapp_ap.conf \
        -F /etc/map/mapd_cfg \
        -u /etc/map/mapd_user.cfg \
        -K /etc/map/1905d.cfg \
        -cra0 -crax0 > /tmp/wapp_bg.log 2>&1 &
}

stop() {
    killall -9 wapp 2>/dev/null
}
