---
[v1] net: ppp: Add API to acquire PPP socket for MediaTek tunnel hardware offload

Some tunnel information, such as UDP port number, is stored inside socket
structure. However, currently there is no way to acquire socket structure via
skb or any exist API. Implement a new extern API to get socket information via
a tunnel network device so that MediaTek tunnel offload hardware can acquire
essential information for L2TP, PPTP tunnel hardware acceleration.

---
v1: Move openwrt-master files to openwrt-25.12 branch after OpenWrt official
    25.12 branch release.
---

--- a/drivers/net/ppp/ppp_generic.c
+++ b/drivers/net/ppp/ppp_generic.c
@@ -53,3 +53,4 @@
 #include <linux/nsproxy.h>
 #include <net/net_namespace.h>
 #include <net/netns/generic.h>
+#include <net/sock.h>
@@ -1911,6 +1912,42 @@ ppp_send_frame(struct ppp *ppp, struct s
 	++ppp->dev->stats.tx_errors;
 }
 
+struct sock *ppp_netdev_get_sock(struct net_device *dev)
+{
+	struct channel *pch;
+	struct ppp_channel *chan;
+	struct ppp *ppp;
+	struct sock *sk = ERR_PTR(-EINVAL);
+
+	if (!dev)
+		return ERR_PTR(-EINVAL);
+
+	ppp = netdev_priv(dev);
+
+	spin_lock_bh(&ppp->wlock);
+	if (ppp->flags & SC_MULTILINK) {
+		sk = ERR_PTR(-EPERM);
+		goto out;
+	}
+
+	pch = list_first_entry_or_null(&ppp->channels, struct channel, clist);
+	if (!pch)
+		goto out;
+
+	spin_lock_bh(&pch->downl);
+	chan = pch->chan;
+	if (chan && chan->private) {
+		sk = chan->private;
+		sock_hold(sk);
+	}
+	spin_unlock_bh(&pch->downl);
+out:
+	spin_unlock_bh(&ppp->wlock);
+
+	return sk;
+}
+EXPORT_SYMBOL(ppp_netdev_get_sock);
+
 /*
  * Try to send the frame in xmit_pending.
  * The caller should have the xmit path locked.
--- a/include/linux/ppp_channel.h
+++ b/include/linux/ppp_channel.h
@@ -23,3 +23,4 @@
 struct net_device_path;
 struct net_device_path_ctx;
 struct ppp_channel;
+struct sock;
@@ -78,6 +79,9 @@ extern int ppp_unit_number(struct ppp_ch
 /* Get the device name associated with a channel, or NULL if none */
 extern char *ppp_dev_name(struct ppp_channel *);
 
+/* Get a referenced socket for a PPP netdev; caller must sock_put(). */
+extern struct sock *ppp_netdev_get_sock(struct net_device *dev);
