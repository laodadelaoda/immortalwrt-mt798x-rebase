+int mtk_pcie_soft_off(struct pci_bus *bus)
+{
+	struct pci_host_bridge *host;
+	struct mtk_gen3_pcie *pcie;
+	struct pci_dev *dev;
+	int ret;
+
+	if (!bus)
+		return -ENODEV;
+
+	pcie = bus->sysdata;
+	if (!pcie)
+		return -ENODEV;
+
+	mutex_lock(&pcie->power_lock);
+	if (READ_ONCE(pcie->soft_off)) {
+		ret = -EPERM;
+		goto out_unlock;
+	}
+
+	host = pci_host_bridge_from_priv(pcie);
+	if (!host || !host->bus) {
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+
+	dev = pci_get_slot(host->bus, 0);
+	if (!dev) {
+		dev_err(pcie->dev, "Failed to get device from bus\n");
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+
+	ret = pci_save_state(dev);
+	if (ret)
+		goto out_put_dev;
+
+	/* Trigger link to L2 state */
+	ret = mtk_pcie_turn_off_link(pcie);
+	if (ret)
+		goto out_put_dev;
+
+	mtk_pcie_irq_save(pcie);
+	WRITE_ONCE(pcie->soft_off, true);
+	mtk_pcie_power_down(pcie);
+	pci_dev_put(dev);
+	mutex_unlock(&pcie->power_lock);
+	dev_info(pcie->dev, "mtk pcie soft off done\n");
+	return 0;
+
+out_put_dev:
+	pci_dev_put(dev);
+out_unlock:
+	mutex_unlock(&pcie->power_lock);
+	return ret;
+}
+EXPORT_SYMBOL(mtk_pcie_soft_off);
+
+int mtk_pcie_soft_on(struct pci_bus *bus)
+{
+	struct pci_host_bridge *host;
+	struct mtk_gen3_pcie *pcie;
+	struct pci_dev *dev;
+	int ret;
+
+	if (!bus)
+		return -ENODEV;
+
+	pcie = bus->sysdata;
+	if (!pcie)
+		return -ENODEV;
+
+	mutex_lock(&pcie->power_lock);
+	if (!READ_ONCE(pcie->soft_off)) {
+		ret = -EPERM;
+		goto out_unlock;
+	}
+
+	host = pci_host_bridge_from_priv(pcie);
+	if (!host || !host->bus) {
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+
+	dev = pci_get_slot(host->bus, 0);
+	if (!dev) {
+		dev_err(pcie->dev, "Failed to get device from bus\n");
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+
+	ret = mtk_pcie_power_up(pcie);
+	if (ret) {
+		dev_err(pcie->dev, "Failed to power up RC\n");
+		goto out_put_dev;
+	}
+
+	ret = mtk_pcie_startup_port(pcie);
+	if (ret) {
+		dev_err(pcie->dev, "Failed to detect EP\n");
+		mtk_pcie_power_down(pcie);
+		goto out_put_dev;
+	}
+
+	WRITE_ONCE(pcie->soft_off, false);
+	mtk_pcie_irq_restore(pcie);
+	pci_restore_state(dev);
+	pci_dev_put(dev);
+	mutex_unlock(&pcie->power_lock);
+	dev_info(pcie->dev, "mtk pcie soft on done\n");
+	return 0;
+
+out_put_dev:
+	pci_dev_put(dev);
+out_unlock:
+	mutex_unlock(&pcie->power_lock);
+	return ret;
+}
+EXPORT_SYMBOL(mtk_pcie_soft_on);
