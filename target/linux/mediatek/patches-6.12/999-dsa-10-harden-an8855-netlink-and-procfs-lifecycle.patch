+int an8855_write(struct an8855_priv *priv, u32 reg, u32 val)
+{
+	if (!priv || !priv->regmap || reg > 0xffff || (reg & 0x3))
+		return -EINVAL;
+
+	return regmap_write(priv->regmap, reg, val);
+}
+
+int an8855_read(struct an8855_priv *priv, u32 reg, u32 *val)
+{
+	if (!priv || !priv->regmap || !val || reg > 0xffff || (reg & 0x3))
+		return -EINVAL;
+
+	return regmap_read(priv->regmap, reg, val);
+}
+
+static struct mii_bus *
+an8855_get_mii_bus(struct an8855_priv *priv, int *switch_addr)
+{
+	struct an8855_mfd_priv *mfd_priv;
+	struct device *parent;
+
+	if (!priv || !priv->ds || !priv->ds->dev)
+		return ERR_PTR(-ENODEV);
+
+	parent = priv->ds->dev->parent;
+	if (!parent)
+		return ERR_PTR(-ENODEV);
+
+	mfd_priv = dev_get_drvdata(parent);
+	if (!mfd_priv || !mfd_priv->bus)
+		return ERR_PTR(-ENODEV);
+
+	*switch_addr = mfd_priv->switch_addr;
+	return mfd_priv->bus;
+}
+
+int an8855_phy_cl22_read(struct an8855_priv *priv, int port, int regnum)
+{
+	struct mii_bus *bus;
+	int switch_addr;
+
+	if (!priv || !priv->ds || port < 0 || port >= priv->ds->num_ports ||
+	    regnum < 0 || regnum > 31)
+		return -EINVAL;
+
+	bus = an8855_get_mii_bus(priv, &switch_addr);
+	if (IS_ERR(bus))
+		return PTR_ERR(bus);
+
+	return mdiobus_read(bus, port + switch_addr, regnum);
+}
+
+int an8855_phy_cl22_write(struct an8855_priv *priv, int port, int regnum,
+			  u16 val)
+{
+	struct mii_bus *bus;
+	int switch_addr;
+
+	if (!priv || !priv->ds || port < 0 || port >= priv->ds->num_ports ||
+	    regnum < 0 || regnum > 31)
+		return -EINVAL;
+
+	bus = an8855_get_mii_bus(priv, &switch_addr);
+	if (IS_ERR(bus))
+		return PTR_ERR(bus);
+
+	return mdiobus_write(bus, port + switch_addr, regnum, val);
+}
+
+int an8855_phy_cl45_read(struct an8855_priv *priv, int port, int devad,
+			 int regnum)
+{
+	struct mii_bus *bus;
+	int switch_addr;
+
+	if (!priv || !priv->ds || port < 0 || port >= priv->ds->num_ports ||
+	    devad < 0 || devad > 31 || regnum < 0 || regnum > 0xffff)
+		return -EINVAL;
+
+	bus = an8855_get_mii_bus(priv, &switch_addr);
+	if (IS_ERR(bus))
+		return PTR_ERR(bus);
+
+	return mdiobus_c45_read(bus, port + switch_addr, devad, regnum);
+}
+
+int an8855_phy_cl45_write(struct an8855_priv *priv, int port, int devad,
+			  int regnum, u16 val)
+{
+	struct mii_bus *bus;
+	int switch_addr;
+
+	if (!priv || !priv->ds || port < 0 || port >= priv->ds->num_ports ||
+	    devad < 0 || devad > 31 || regnum < 0 || regnum > 0xffff)
+		return -EINVAL;
+
+	bus = an8855_get_mii_bus(priv, &switch_addr);
+	if (IS_ERR(bus))
+		return PTR_ERR(bus);
+
+	return mdiobus_c45_write(bus, port + switch_addr, devad, regnum, val);
+}
