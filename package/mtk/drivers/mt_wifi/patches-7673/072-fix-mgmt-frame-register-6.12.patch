diff -ru a/mt_wifi/os/linux/cfg80211/cfg80211.c b/mt_wifi/os/linux/cfg80211/cfg80211.c
--- a/mt_wifi/os/linux/cfg80211/cfg80211.c	2026-10-19 13:59:01.161953989 +0800
+++ b/mt_wifi/os/linux/cfg80211/cfg80211.c	2026-10-19 14:06:19.591588856 +0800
@@ -2449,6 +2449,32 @@
 		CFG80211DBG(DBG_LVL_ERROR, ("Unkown frame_type = %x, req = %d\n", frame_type, reg));
 }
 
+#if (KERNEL_VERSION(6, 12, 0) <= LINUX_VERSION_CODE)
+static void CFG80211_OpsUpdateMgmtFrameRegs(
+        struct wiphy *pWiphy,
+        struct wireless_dev *wdev,
+        struct mgmt_frame_regs *upd)
+{
+        VOID *pAd;
+        struct net_device *dev = NULL;
+        BOOLEAN new_probe, new_action;
+
+        MAC80211_PAD_GET_NO_RV(pAd, pWiphy);
+        RTMP_DRIVER_NET_DEV_GET(pAd, &dev);
+
+        /* MTK 硬件不区分组播管理帧过滤，只处理 interface_stypes 的
+         * Probe Request (BIT(4)) 和 Action (BIT(13))，忽略 mcast 位图
+         */
+        new_probe  = (upd->interface_stypes & BIT(IEEE80211_STYPE_PROBE_REQ >> 4)) ? TRUE : FALSE;
+        new_action = (upd->interface_stypes & BIT(IEEE80211_STYPE_ACTION >> 4)) ? TRUE : FALSE;
+
+        if (new_probe != pAd->cfg80211_ctrl.cfg80211MainDev.Cfg80211RegisterProbeReqFrame)
+                RTMP_DRIVER_80211_MGMT_FRAME_REG(pAd, dev, new_probe);
+        if (new_action != pAd->cfg80211_ctrl.cfg80211MainDev.Cfg80211RegisterActionFrame)
+                RTMP_DRIVER_80211_ACTION_FRAME_REG(pAd, dev, new_action);
+}
+#endif /* KERNEL_VERSION(6,12,0) */
+
 /* Supplicant_NEW_TDLS */
 #ifdef CFG_TDLS_SUPPORT
 static int CFG80211_OpsTdlsMgmt
@@ -3878,7 +3904,9 @@
 	.set_cqm_rssi_config		= NULL,
 #endif /* LINUX_VERSION_CODE */
 
-#if (KERNEL_VERSION(2, 6, 37) <= LINUX_VERSION_CODE)
+#if (KERNEL_VERSION(6, 12, 0) <= LINUX_VERSION_CODE)
+	.update_mgmt_frame_registrations = CFG80211_OpsUpdateMgmtFrameRegs,
+#elif (KERNEL_VERSION(2, 6, 37) <= LINUX_VERSION_CODE)
 	/* notify driver that a management frame type was registered */
 	.mgmt_frame_register		= CFG80211_OpsMgmtFrameRegister,
 #endif /* LINUX_VERSION_CODE : 2.6.37 */
