+int FlashRead(char *name, unsigned char *value, unsigned long offset, unsigned long size)
 {
-	mt_eeprom_read_wifi(offset, size, value);
+	int ret;
+
+	if (!value && size)
+		return -EINVAL;
+	if (!size)
+		return 0;
+
+	memset(value, 0, size);
+	ret = mt_eeprom_read_wifi(offset, size, value);
+	if (ret)
+		pr_err("failed to read EEPROM name=%s offset=0x%lx size=0x%lx ret=%d\n",
+		       name ? name : "(null)", offset, size, ret);
+
+	return ret;
 }
 
