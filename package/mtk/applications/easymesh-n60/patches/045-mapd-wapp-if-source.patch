+#ifdef MAP_R2
+/* Validate the variable-length association-status payload before parsing it. */
+static int wapp_assoc_status_notif_valid(const struct msg *event)
+{
+	const unsigned char *buffer;
+	const struct assoc_notification *assoc;
+	size_t offset;
+	unsigned int i;
+
+	if (!event || event->length < sizeof(*assoc))
+		return 0;
+
+	buffer = (const unsigned char *)event->buffer;
+	assoc = (const struct assoc_notification *)buffer;
+	offset = sizeof(*assoc);
+
+	for (i = 0; i < assoc->notification_tlv_num; i++) {
+		const struct notification_tlv *tlv;
+		size_t status_bytes;
+
+		if (offset > event->length ||
+		    event->length - offset < sizeof(*tlv))
+			return 0;
+
+		tlv = (const struct notification_tlv *)(buffer + offset);
+		offset += sizeof(*tlv);
+		status_bytes = (size_t)tlv->bssid_num * sizeof(struct status);
+		if (status_bytes > event->length - offset)
+			return 0;
+		offset += status_bytes;
+	}
+
+	return offset == event->length;
+}
+#endif /* MAP_R2 */
