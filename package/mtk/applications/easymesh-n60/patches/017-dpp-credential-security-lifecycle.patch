+#ifndef DPP_DEBUG_REDACT_H
+#define DPP_DEBUG_REDACT_H
+
+/* DPP hexdump payloads may include credentials or derived key material.
+ * Keep one shared redaction policy for all DPP translation units.
+ */
+#define DPP_REDACT_DUMP(level, title, data, data_len) do { \
+	(void) (data); \
+	(void) (data_len); \
+	wpa_printf((level), "%s: [REDACTED]", (title)); \
+} while (0)
+#define wpa_hexdump(level, title, buf, len) DPP_REDACT_DUMP(level, title, buf, len)
+#define wpa_hexdump_ascii(level, title, buf, len) DPP_REDACT_DUMP(level, title, buf, len)
