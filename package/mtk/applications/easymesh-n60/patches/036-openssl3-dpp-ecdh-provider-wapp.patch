+struct wpabuf * crypto_ecdh_set_peerkey(struct crypto_ecdh *ecdh, int inc_y,
+					const u8 *key, size_t len)
+{
+	BIGNUM *x = NULL, *y = NULL;
+	EC_POINT *pub = NULL;
+	BN_CTX *bnctx = NULL;
+	EVP_PKEY_CTX *fromdata_ctx = NULL, *derive_ctx = NULL;
+	EVP_PKEY *peerkey = NULL;
+	OSSL_PARAM params[3];
+	struct wpabuf *secret = NULL;
+	unsigned char *pub_octets = NULL;
+	const char *group_name;
+	size_t coord_len, pub_len, secret_len = 0;
+	int ret = -1;
+
+	if (!ecdh || !ecdh->ec || !ecdh->pkey || !key)
+		return NULL;
+	if (BN_num_bytes(ecdh->ec->prime) <= 0)
+		return NULL;
+	coord_len = (size_t) BN_num_bytes(ecdh->ec->prime);
+	if (coord_len > (size_t) INT_MAX / 2 ||
+	    (inc_y ? len != 2 * coord_len : len != coord_len) ||
+	    coord_len > INT_MAX)
+		return NULL;
+
+	x = BN_bin2bn(key, (int) coord_len, NULL);
+	if (inc_y)
+		y = BN_bin2bn(key + coord_len, (int) coord_len, NULL);
+	pub = EC_POINT_new(ecdh->ec->group);
+	bnctx = BN_CTX_new();
+	if (!x || (inc_y && !y) || !pub || !bnctx)
+		goto done;
+
+	if ((inc_y && EC_POINT_set_affine_coordinates(ecdh->ec->group, pub,
+							      x, y, bnctx) != 1) ||
+	    (!inc_y && EC_POINT_set_compressed_coordinates(ecdh->ec->group,
+								 pub, x, 0, bnctx) != 1) ||
+	    EC_POINT_is_at_infinity(ecdh->ec->group, pub) != 0 ||
+	    EC_POINT_is_on_curve(ecdh->ec->group, pub, bnctx) != 1)
+		goto done;
+
+	pub_len = EC_POINT_point2oct(ecdh->ec->group, pub,
+				     POINT_CONVERSION_UNCOMPRESSED,
+				     NULL, 0, bnctx);
+	if (pub_len != 1 + 2 * coord_len)
+		goto done;
+	pub_octets = OPENSSL_malloc(pub_len);
+	if (!pub_octets ||
+	    EC_POINT_point2oct(ecdh->ec->group, pub,
+			       POINT_CONVERSION_UNCOMPRESSED,
+			       pub_octets, pub_len, bnctx) != pub_len)
+		goto done;
+
+	group_name = OBJ_nid2sn(ecdh->ec->nid);
+	if (!group_name)
+		goto done;
+	fromdata_ctx = EVP_PKEY_CTX_new_from_name(NULL, "EC", NULL);
+	if (!fromdata_ctx || EVP_PKEY_fromdata_init(fromdata_ctx) <= 0)
+		goto done;
+	params[0] = OSSL_PARAM_construct_utf8_string(
+		OSSL_PKEY_PARAM_GROUP_NAME, (char *) group_name, 0);
+	params[1] = OSSL_PARAM_construct_octet_string(
+		OSSL_PKEY_PARAM_PUB_KEY, pub_octets, pub_len);
+	params[2] = OSSL_PARAM_construct_end();
+	if (EVP_PKEY_fromdata(fromdata_ctx, &peerkey, EVP_PKEY_PUBLIC_KEY,
+			      params) <= 0)
+		goto done;
+
+	derive_ctx = EVP_PKEY_CTX_new_from_pkey(NULL, ecdh->pkey, NULL);
+	if (!derive_ctx || EVP_PKEY_derive_init(derive_ctx) <= 0 ||
+	    EVP_PKEY_derive_set_peer_ex(derive_ctx, peerkey, 1) <= 0 ||
+	    EVP_PKEY_derive(derive_ctx, NULL, &secret_len) <= 0 ||
+	    secret_len != coord_len)
+		goto done;
+
+	secret = wpabuf_alloc(secret_len);
+	if (!secret ||
+	    EVP_PKEY_derive(derive_ctx, wpabuf_put(secret, secret_len),
+			    &secret_len) <= 0 || secret_len != coord_len)
+		goto done;
+	ret = 0;
 
 done:
 	BN_clear_free(x);
 	BN_clear_free(y);
-	EC_KEY_free(eckey);
-
-	return buf;
-fail:
-	wpabuf_free(buf);
-	buf = NULL;
-	goto done;
-}
