 #ifdef MAP_R3
+int dpp_read_qr_parameter(struct wifi_app *wapp, const char *param,
+			  char *value, size_t value_len)
+{
+	if (!wapp || !wapp->map || !param || !value || !value_len)
+		return -1;
+	value[0] = '\0';
+#ifdef OPENWRT_SUPPORT
+	{
+		struct kvc_context *dat_ctx;
+		const char *stored;
+		size_t len;
+		int ret = -1;
+
+		dat_ctx = dat_load(DPP_CFG_FILE);
+		if (!dat_ctx)
+			return -1;
+		stored = kvc_get(dat_ctx, param);
+		if (!stored) {
+			ret = 1;
+			goto out;
+		}
+		len = os_strlen(stored);
+		if (len >= value_len)
+			goto out;
+		os_memcpy(value, stored, len + 1);
+		ret = 0;
+out:
+		kvc_unload(dat_ctx);
+		return ret;
+	}
+#else
+	if (get_dpp_parameters(wapp->map, (char *)param, value, value_len) < 0)
+		return -1;
+	return 0;
+#endif
+}
+
+int dpp_read_qr_count(struct wifi_app *wapp, unsigned int *count)
+{
+	char value[16] = {0};
+	size_t len, i;
+	unsigned int parsed = 0;
+	int ret;
+
+	if (!count)
+		return -1;
+	*count = 0;
+	ret = dpp_read_qr_parameter(wapp, "qr_count", value, sizeof(value));
+	if (ret == 1)
+		return 0;
+	if (ret < 0)
+		return -1;
+	len = os_strlen(value);
+	if (!len || len > 3)
+		return -1;
+	for (i = 0; i < len; i++) {
+		unsigned int digit;
+
+		if (value[i] < '0' || value[i] > '9')
+			return -1;
+		digit = (unsigned int)(value[i] - '0');
+		parsed = parsed * 10 + digit;
+		if (parsed > MAP_MAX_DPP_URI_COUNT)
+			return -1;
+	}
+	*count = parsed;
+	return 0;
+}
