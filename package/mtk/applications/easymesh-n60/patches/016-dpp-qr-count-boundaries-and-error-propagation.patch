+int dpp_read_qr_count(struct wifi_app *wapp, unsigned int *count)
+{
+	char value[16] = {0};
+	size_t len, i;
+	unsigned int parsed = 0;
+	int ret;
+
+	if (!count)
+		return -1;
+	*count = 0;
+	ret = dpp_read_qr_parameter(wapp, "qr_count", value, sizeof(value));
+	if (ret == 1)
+		return 0;
+	if (ret < 0)
+		return -1;
+	len = os_strlen(value);
+	if (!len || len > 3)
+		return -1;
+	for (i = 0; i < len; i++) {
+		unsigned int digit;
+
+		if (value[i] < '0' || value[i] > '9')
+			return -1;
+		digit = (unsigned int)(value[i] - '0');
+		parsed = parsed * 10 + digit;
+		if (parsed > MAP_MAX_DPP_URI_COUNT)
+			return -1;
+	}
+	*count = parsed;
+	return 0;
+}
