From: N60 Pro OpenSSL migration
Subject: [PATCH] easymesh: migrate DPP authentication to EVP_PKEY accessors

Replace deprecated EC_KEY extraction in DPP authentication key derivation
with OpenSSL 3 EVP_PKEY parameter access. Keep the existing M-point
derivation and secret serialization semantics while validating that all
participating keys use the same EC group.

Use owned EC_POINT, EC_GROUP and BIGNUM objects with cleanup on every
failure path; clear private scalar material before release.

diff --git a/wappd/dpp/dpp.c b/wappd/dpp/dpp.c
--- a/wappd/dpp/dpp.c
+++ b/wappd/dpp/dpp.c
@@ -12,6 +12,7 @@
 #include <openssl/asn1.h>
 #include <openssl/asn1t.h>
 #include <openssl/evp.h>
+#include <openssl/core_names.h>
 #include "crypto/evp.h"
 #include "wapp_cmm.h"
 
@@ -14472,39 +14473,98 @@
 	return secret_len;
 }
 
+/* Extract an EC group name from an EVP_PKEY without using deprecated EC_KEY APIs. */
+static int dpp_evp_pkey_get_group(const EVP_PKEY *pkey, EC_GROUP **group)
+{
+	char group_name[80] = { 0 };
+	size_t group_name_len = 0;
+	int nid;
+
+	if (!pkey || !group)
+		return -1;
+	*group = NULL;
+	if (!EVP_PKEY_is_a(pkey, "EC") ||
+	    EVP_PKEY_get_utf8_string_param(pkey, OSSL_PKEY_PARAM_GROUP_NAME,
+					   group_name, sizeof(group_name),
+					   &group_name_len) != 1)
+		return -1;
+
+	nid = OBJ_txt2nid(group_name);
+	if (nid == NID_undef)
+		return -1;
+
+	*group = EC_GROUP_new_by_curve_name(nid);
+	return *group ? 0 : -1;
+}
+
+/* Decode an EVP_PKEY public point into the caller's validated EC group. */
+static int dpp_evp_pkey_get_public_point(const EVP_PKEY *pkey,
+					const EC_GROUP *group,
+					EC_POINT **point)
+{
+	unsigned char *encoded = NULL;
+	size_t encoded_len = 0;
+	EC_GROUP *key_group = NULL;
+	int ret = -1;
+
+	if (!pkey || !group || !point)
+		return -1;
+	*point = NULL;
+	if (dpp_evp_pkey_get_group(pkey, &key_group) < 0 ||
+	    EC_GROUP_cmp(group, key_group, NULL) != 0)
+		goto out;
+
+	if (EVP_PKEY_get_octet_string_param(pkey, OSSL_PKEY_PARAM_PUB_KEY,
+					    NULL, 0, &encoded_len) != 1 ||
+	    !encoded_len)
+		goto out;
+	encoded = OPENSSL_malloc(encoded_len);
+	if (!encoded ||
+	    EVP_PKEY_get_octet_string_param(pkey, OSSL_PKEY_PARAM_PUB_KEY,
+					    encoded, encoded_len,
+					    &encoded_len) != 1)
+		goto out;
+
+	*point = EC_POINT_new(group);
+	if (!*point || EC_POINT_oct2point(group, *point, encoded,
+					  encoded_len, NULL) != 1) {
+		EC_POINT_clear_free(*point);
+		*point = NULL;
+		goto out;
+	}
+	ret = 0;
+out:
+	OPENSSL_free(encoded);
+	EC_GROUP_free(key_group);
+	return ret;
+}
+
