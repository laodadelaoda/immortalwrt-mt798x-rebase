From: N60 Pro OpenSSL migration
Subject: [PATCH] easymesh: decode DPP private keys into EVP_PKEY

On OpenSSL 3, decode the DER private key directly into the provider-facing
EVP_PKEY object, require complete DER consumption and an EC key, and retain
the existing DPP curve allow-list validation. Older OpenSSL keeps the
EC_KEY decoder compatibility path.

--- a/wappd/dpp/dpp.c
+++ b/wappd/dpp/dpp.c
@@ -1305,6 +1305,30 @@
 EVP_PKEY * dpp_set_keypair(const struct dpp_curve_params **curve,
 				  const u8 *privkey, size_t privkey_len)
 {
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+	EVP_PKEY *pkey = NULL;
+	char group_name[80];
+	size_t group_name_len = 0;
+	const unsigned char *pos = privkey;
+	int nid;
+
+	if (!curve || !privkey || !privkey_len || privkey_len > LONG_MAX)
+		return NULL;
+	pkey = d2i_AutoPrivateKey(NULL, &pos, (long) privkey_len);
+	if (!pkey || pos != privkey + privkey_len ||
+	    !EVP_PKEY_is_a(pkey, "EC") ||
+	    EVP_PKEY_get_group_name(pkey, group_name, sizeof(group_name),
+				    &group_name_len) != 1)
+		goto fail;
+	nid = OBJ_txt2nid(group_name);
+	*curve = dpp_get_curve_nid(nid);
+	if (!*curve)
+		goto fail;
+	return pkey;
+fail:
+	EVP_PKEY_free(pkey);
+	return NULL;
+#else
 	EVP_PKEY *pkey;
 	EC_KEY *eckey;
 	const EC_GROUP *group;
@@ -1344,7 +1368,8 @@
 		return NULL;
 	}
 	return pkey;
+#endif
 }
 
 
