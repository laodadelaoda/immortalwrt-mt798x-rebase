diff --git a/1905daemon/src/dpp.c b/1905daemon/src/dpp.c
index 7ef2528..c9959fa 100644
--- a/1905daemon/src/dpp.c
+++ b/1905daemon/src/dpp.c
@@ -1956,45 +1956,28 @@ dpp_get_curve_jwk_crv(const char *name)
 static EVP_PKEY * dpp_set_keypair(const struct dpp_curve_params **curve,
 				  const u8 *privkey, size_t privkey_len)
 {
-	EVP_PKEY *pkey;
-	EC_KEY *eckey;
-	const EC_GROUP *group;
+	EVP_PKEY *pkey = NULL;
+	char group_name[80] = { 0 };
+	size_t group_name_len = 0;
+	const unsigned char *pos = privkey;
 	int nid;
 
-	pkey = EVP_PKEY_new();
-	if (!pkey)
+	if (!curve || !privkey || !privkey_len || privkey_len > LONG_MAX)
 		return NULL;
-	eckey = d2i_ECPrivateKey(NULL, &privkey, privkey_len);
-	if (!eckey) {
-		wpa_printf(MSG_INFO,
-			   "DPP: OpenSSL: d2i_ECPrivateKey() failed: %s",
-			   ERR_error_string(ERR_get_error(), NULL));
-		EVP_PKEY_free(pkey);
-		return NULL;
-	}
-	group = EC_KEY_get0_group(eckey);
-	if (!group) {
-		EC_KEY_free(eckey);
-		EVP_PKEY_free(pkey);
-		return NULL;
-	}
-	nid = EC_GROUP_get_curve_name(group);
+	pkey = d2i_AutoPrivateKey(NULL, &pos, (long) privkey_len);
+	if (!pkey || pos != privkey + privkey_len ||
+	    !EVP_PKEY_is_a(pkey, "EC") ||
+	    EVP_PKEY_get_group_name(pkey, group_name, sizeof(group_name),
+				    &group_name_len) != 1)
+		goto fail;
+	nid = OBJ_txt2nid(group_name);
 	*curve = dpp_get_curve_nid(nid);
-	if (!*curve) {
-		wpa_printf(MSG_INFO,
-			   "DPP: Unsupported curve (nid=%d) in pre-assigned key",
-			   nid);
-		EC_KEY_free(eckey);
-		EVP_PKEY_free(pkey);
-		return NULL;
-	}
-
-	if (EVP_PKEY_assign_EC_KEY(pkey, eckey) != 1) {
-		EC_KEY_free(eckey);
-		EVP_PKEY_free(pkey);
-		return NULL;
-	}
+	if (!*curve)
+		goto fail;
 	return pkey;
+fail:
+	EVP_PKEY_free(pkey);
+	return NULL;
 }
 
 
