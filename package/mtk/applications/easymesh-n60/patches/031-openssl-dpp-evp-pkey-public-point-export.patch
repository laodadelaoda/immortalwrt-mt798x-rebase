From: N60 Pro OpenSSL migration
Subject: [PATCH] easymesh: export DPP public points from EVP_PKEY

Use EVP_PKEY_get1_encoded_public_key instead of extracting a temporary
EC_KEY and calling i2o_ECPublicKey. OpenSSL returns the SEC1 encoded point;
the existing DPP x||y form is preserved when prefix is not requested.

--- a/wappd/dpp/dpp.c
+++ b/wappd/dpp/dpp.c
@@ -404,38 +404,29 @@
 struct wpabuf * dpp_get_pubkey_point(EVP_PKEY *pkey, int prefix)
 {
-	int len, res;
-	EC_KEY *eckey;
+	size_t len;
+	unsigned char *encoded = NULL;
 	struct wpabuf *buf;
 	unsigned char *pos;
 
-	eckey = EVP_PKEY_get1_EC_KEY(pkey);
-	if (!eckey)
+	if (!pkey)
 		return NULL;
-	EC_KEY_set_conv_form(eckey, POINT_CONVERSION_UNCOMPRESSED);
-	len = i2o_ECPublicKey(eckey, NULL);
-	if (len <= 0) {
+	encoded = EVP_PKEY_get1_encoded_public_key(pkey, &len);
+	if (!encoded || !len || len > INT_MAX) {
 		wpa_printf(MSG_ERROR, DPP_MAP_PREX
 			   "DDP: Failed to determine public key encoding length");
-		EC_KEY_free(eckey);
+		OPENSSL_free(encoded);
 		return NULL;
 	}
 
 	buf = wpabuf_alloc(len);
 	if (!buf) {
-		EC_KEY_free(eckey);
+		OPENSSL_free(encoded);
 		return NULL;
 	}
 
 	pos = wpabuf_put(buf, len);
-	res = i2o_ECPublicKey(eckey, &pos);
-	EC_KEY_free(eckey);
-	if (res != len) {
-		wpa_printf(MSG_ERROR, DPP_MAP_PREX
-			   "DDP: Failed to encode public key (res=%d/%d)",
-			   res, len);
-		wpabuf_free(buf);
-		return NULL;
-	}
+	os_memcpy(pos, encoded, len);
+	OPENSSL_free(encoded);
 
 	if (!prefix) {
 		/* Remove 0x04 prefix to match DPP definition */
@@ -1128,38 +1123,29 @@
