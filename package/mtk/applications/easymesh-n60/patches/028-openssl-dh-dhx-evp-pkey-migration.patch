+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+/* Build immutable provider-managed DHX keys from the
+ * fixed RFC 3526 group 5 parameters. The returned EVP_PKEY owns its data. */
+static EVP_PKEY * dh5_fromdata(const BIGNUM *pub, const BIGNUM *priv,
+			       int selection)
+{
+	EVP_PKEY_CTX *ctx = NULL;
+	OSSL_PARAM_BLD *bld = NULL;
+	OSSL_PARAM *params = NULL;
+	EVP_PKEY *pkey = NULL;
+	BIGNUM *p = NULL, *q = NULL, *g = NULL;
+
+	p = get_group5_prime();
+	g = BN_new();
+	ctx = EVP_PKEY_CTX_new_from_name(NULL, "DHX", NULL);
+	bld = OSSL_PARAM_BLD_new();
+	if (!p || !g || BN_set_word(g, 2) != 1 || !ctx || !bld ||
+	    !OSSL_PARAM_BLD_push_BN(bld, OSSL_PKEY_PARAM_FFC_P, p) ||
+	    !OSSL_PARAM_BLD_push_BN(bld, OSSL_PKEY_PARAM_FFC_G, g) ||
+	    !(q = get_group5_order()) ||
+	    !OSSL_PARAM_BLD_push_BN(bld, OSSL_PKEY_PARAM_FFC_Q, q) ||
+	    (pub && !OSSL_PARAM_BLD_push_BN(bld, OSSL_PKEY_PARAM_PUB_KEY, pub)) ||
+	    (priv && !OSSL_PARAM_BLD_push_BN(bld, OSSL_PKEY_PARAM_PRIV_KEY, priv)))
+		goto done;
+	params = OSSL_PARAM_BLD_to_param(bld);
+	if (!params || EVP_PKEY_fromdata_init(ctx) <= 0 ||
+	    EVP_PKEY_fromdata(ctx, &pkey, selection, params) <= 0) {
+		EVP_PKEY_free(pkey);
+		pkey = NULL;
+	}
+
+done:
+	BN_free(p);
+	BN_free(q);
+	BN_free(g);
+	OSSL_PARAM_free(params);
+	OSSL_PARAM_BLD_free(bld);
+	EVP_PKEY_CTX_free(ctx);
+	return pkey;
+}
+
+static EVP_PKEY * dh5_generate_key(void)
+{
+	EVP_PKEY *params = NULL, *key = NULL;
+	EVP_PKEY_CTX *ctx = NULL;
+
+	params = dh5_fromdata(NULL, NULL, EVP_PKEY_KEY_PARAMETERS);
+	if (!params)
+		goto done;
+	ctx = EVP_PKEY_CTX_new_from_pkey(NULL, params, NULL);
+	if (!ctx || EVP_PKEY_keygen_init(ctx) <= 0 ||
+	    EVP_PKEY_generate(ctx, &key) <= 0) {
+		EVP_PKEY_free(key);
+		key = NULL;
+	}
+
+done:
+	EVP_PKEY_CTX_free(ctx);
+	EVP_PKEY_free(params);
+	return key;
+}
+#endif /* OpenSSL 3.0 */
+
 void * dh5_init(struct wpabuf **priv, struct wpabuf **publ)
 {
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+	EVP_PKEY *key;
+	struct wpabuf *pubkey = NULL, *privkey = NULL;
+	BIGNUM *pub = NULL, *priv_bn = NULL;
+	int publen, privlen;
+
+	if (!priv || !publ)
+		return NULL;
+	*priv = NULL;
+	wpabuf_free(*publ);
+	*publ = NULL;
+
+	key = dh5_generate_key();
+	if (!key)
+		return NULL;
+	if (EVP_PKEY_get_bn_param(key, OSSL_PKEY_PARAM_PUB_KEY, &pub) <= 0 ||
+	    EVP_PKEY_get_bn_param(key, OSSL_PKEY_PARAM_PRIV_KEY, &priv_bn) <= 0)
+		goto err;
+	publen = BN_num_bytes(pub);
+	privlen = BN_num_bytes(priv_bn);
+	if (publen <= 0 || privlen <= 0)
+		goto err;
+	pubkey = wpabuf_alloc(publen);
+	privkey = wpabuf_alloc(privlen);
+	if (!pubkey || !privkey)
+		goto err;
+	if (BN_bn2bin(pub, wpabuf_put(pubkey, publen)) != publen ||
+	    BN_bn2bin(priv_bn, wpabuf_put(privkey, privlen)) != privlen)
+		goto err;
+	*publ = pubkey;
+	BN_clear_free(priv_bn);
+	BN_free(pub);
+	*priv = privkey;
+	return key;
+err:
+	BN_free(pub);
+	BN_clear_free(priv_bn);
+	wpabuf_clear_free(pubkey);
+	wpabuf_clear_free(privkey);
+	EVP_PKEY_free(key);
+	return NULL;
+#else
 #if OPENSSL_VERSION_NUMBER < 0x10100000L || \
 	(defined(LIBRESSL_VERSION_NUMBER) && \
 	 LIBRESSL_VERSION_NUMBER < 0x20700000L)
