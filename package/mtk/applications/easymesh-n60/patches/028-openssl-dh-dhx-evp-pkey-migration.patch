+	EVP_PKEY_CTX *dctx = NULL;
+	BIGNUM *pub_bn = NULL;
+	struct wpabuf *res = NULL;
+	OSSL_PARAM params[2];
+	unsigned int pad = 0;
+	size_t keylen = 0;
+	int maxlen;
+
+	if (!own || !peer_public || !wpabuf_len(peer_public) ||
+	    wpabuf_len(peer_public) > INT_MAX)
+		return NULL;
+	pub_bn = BN_bin2bn(wpabuf_head(peer_public),
+			   (int) wpabuf_len(peer_public), NULL);
+	if (!pub_bn)
+		goto done;
+	peer = dh5_fromdata(pub_bn, NULL, EVP_PKEY_PUBLIC_KEY);
+	if (!peer)
