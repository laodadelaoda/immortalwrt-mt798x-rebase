+		goto done;
+	res = wpabuf_alloc(maxlen);
+	if (!res || EVP_PKEY_derive(dctx, wpabuf_mhead(res), &keylen) <= 0 ||
+	    keylen > (size_t) maxlen)
+		goto err;
+	wpabuf_put(res, keylen);
+	goto done;
+err:
+	wpabuf_clear_free(res);
+	res = NULL;
+done:
+	BN_clear_free(pub_bn);
+	EVP_PKEY_free(peer);
+	EVP_PKEY_CTX_free(dctx);
+	return res;
+#else
 	BIGNUM *pub_key;
 	struct wpabuf *res = NULL;
 	size_t rlen;
