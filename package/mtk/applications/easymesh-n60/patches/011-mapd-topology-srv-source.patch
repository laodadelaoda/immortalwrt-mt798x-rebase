From: OpenAI
Subject: [PATCH] easymesh: keep generic MAPD topology APIs available

Keep the generic topology peer-relation implementation available in
non-6E builds, matching its unconditional public header declaration. The
function uses only topology graph lookups and root-distance comparisons.

Keep the generic channel-group matcher, N60 non-6E band classifier, and
existing topology, logging, and GCC14 fixes in this single-source patch.

--- a/mapd/src/topologySrv/topologySrv.c
+++ b/mapd/src/topologySrv/topologySrv.c
@@ -245,9 +245,9 @@
 	else
 		return BAND_5GL;
 }
-#ifdef MAP_6E_SUPPORT
 unsigned char get_band_6E(struct _1905_map_device *dev, unsigned char chan, unsigned char op)
 {
+#ifdef MAP_6E_SUPPORT
 	struct radio_info_db *radio = NULL, *tradio = NULL;
 	u8 is_triband_6G = 0, is_triband = 0;
 
@@ -286,6 +286,26 @@
 
 
 	}
+#else
+	if (!dev) {
+		err("return due to Null Dev");
+		return BAND_UNKNOWN;
+	}
+	/* Preserve vendor band enum semantics on N60 without 6 GHz support. */
+	if (check_is_triband(dev)) {
+		if (IS_MAP_CH_24G(chan) && IS_OP_CLASS_24G(op))
+			return BAND_2G;
+		else if (IS_MAP_CH_5GL(chan) && IS_OP_CLASS_5GL(op))
+			return BAND_5GL;
+		else if (IS_MAP_CH_5GH(chan) && IS_OP_CLASS_5GH(op))
+			return BAND_5GH;
+	} else {
+		if (IS_MAP_CH_24G(chan) && IS_OP_CLASS_24G(op))
+			return BAND_2G;
+		else if (IS_MAP_CH_5G(chan) && IS_OP_CLASS_5G(op))
+			return BAND_5GL;
+	}
+#endif
 	return BAND_UNKNOWN;
 }
