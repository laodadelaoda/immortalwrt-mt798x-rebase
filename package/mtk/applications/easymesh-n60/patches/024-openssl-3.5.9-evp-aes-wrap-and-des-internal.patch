+	EVP_CIPHER *cipher = NULL;
+	EVP_CIPHER_CTX *ctx = NULL;
+	unsigned char *tmp = NULL;
+	size_t tmp_len;
+	int in_len, out_len, outl = 0, finl = 0;
+	int ret = -1;
+
+	if (!kek || !in || !out || n < 2 || n > INT_MAX / 8 - 1)
+		return -1;
+
+	switch (kek_len) {
+	case 16:
+		cipher_name = "AES-128-WRAP";
+		break;
+	case 24:
+		cipher_name = "AES-192-WRAP";
+		break;
+	case 32:
+		cipher_name = "AES-256-WRAP";
+		break;
+	default:
+		return -1;
+	}
+
+	in_len = (n + (encrypt ? 0 : 1)) * 8;
+	out_len = (n + (encrypt ? 1 : 0)) * 8;
+	tmp_len = (size_t) in_len + EVP_MAX_BLOCK_LENGTH;
+	tmp = OPENSSL_malloc(tmp_len);
+	cipher = EVP_CIPHER_fetch(NULL, cipher_name, "provider=default");
+	ctx = EVP_CIPHER_CTX_new();
+	if (!tmp || !cipher || !ctx)
+		goto done;
+
+	EVP_CIPHER_CTX_set_flags(ctx, EVP_CIPHER_CTX_FLAG_WRAP_ALLOW);
+	if (encrypt) {
+		if (EVP_EncryptInit_ex2(ctx, cipher, kek, NULL, NULL) != 1 ||
+		    EVP_EncryptUpdate(ctx, tmp, &outl, in, in_len) != 1 ||
+		    outl < 0 || (size_t) outl > tmp_len ||
+		    EVP_EncryptFinal_ex(ctx, tmp + outl, &finl) != 1)
+			goto done;
+	} else {
+		if (EVP_DecryptInit_ex2(ctx, cipher, kek, NULL, NULL) != 1 ||
+		    EVP_DecryptUpdate(ctx, tmp, &outl, in, in_len) != 1 ||
+		    outl < 0 || (size_t) outl > tmp_len ||
+		    EVP_DecryptFinal_ex(ctx, tmp + outl, &finl) != 1)
+			goto done;
+	}
+
+	if (finl < 0 || (size_t) finl > tmp_len - (size_t) outl ||
+	    outl + finl != out_len)
+		goto done;
+	os_memcpy(out, tmp, out_len);
+	ret = 0;
+
+done:
+	if (ret < 0)
+		OPENSSL_cleanse(out, out_len);
+	OPENSSL_clear_free(tmp, tmp_len);
+	EVP_CIPHER_CTX_free(ctx);
+	EVP_CIPHER_free(cipher);
+	return ret;
+}
