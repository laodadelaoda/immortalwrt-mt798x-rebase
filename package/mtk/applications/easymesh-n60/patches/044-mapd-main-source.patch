+MAPD_ABI_ASSERT(mapd_abi_ap_chn_rpt_size, sizeof(struct ap_chn_rpt) == 61);
+MAPD_ABI_ASSERT(mapd_abi_radio_teardown_offset, offsetof(struct mapd_radio_info, teardown) == 104);
+MAPD_ABI_ASSERT(mapd_runtime_max_ch_num, MAX_CH_NUM == 13);
+MAPD_ABI_ASSERT(mapd_runtime_band_count, IEEE_NUM_BANDS == 2);
+MAPD_ABI_ASSERT(mapd_runtime_channel_count, MAX_NUM_CHANNELS == 42);
+MAPD_ABI_ASSERT(mapd_runtime_channel_bitmap, MAX_CHAN_BITMAP == 6);
+MAPD_ABI_ASSERT(mapd_abi_max_ch_num, MAPD_ABI_MAX_CH_NUM == 59);
+MAPD_ABI_ASSERT(mapd_abi_band_count, MAPD_ABI_NUM_BANDS == 3);
+MAPD_ABI_ASSERT(mapd_abi_channel_count, MAPD_ABI_MAX_NUM_CHANNELS == 101);
+MAPD_ABI_ASSERT(mapd_abi_channel_bitmap, MAPD_ABI_MAX_CHAN_BITMAP == 13);
+#undef MAPD_ABI_ASSERT
+#endif
