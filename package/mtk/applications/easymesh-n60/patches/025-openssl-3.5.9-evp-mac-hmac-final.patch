+static EVP_MAC_CTX * openssl_hmac_ctx_new(const EVP_MD *md, const u8 *key,
+					 size_t key_len)
+{
+	EVP_MAC *mac = NULL;
+	EVP_MAC_CTX *ctx = NULL;
+	OSSL_PARAM params[2];
+	const char *md_name;
+
+	/* HMAC_Init_ex on a new context rejects a NULL key; preserve that rule. */
+	if (!md || !key)
+		return NULL;
+	md_name = EVP_MD_get0_name(md);
+	if (!md_name)
+		return NULL;
+
+	mac = EVP_MAC_fetch(NULL, "HMAC", "provider=default");
+	if (!mac)
+		return NULL;
+	ctx = EVP_MAC_CTX_new(mac);
+	EVP_MAC_free(mac);
+	if (!ctx)
+		return NULL;
+
+	params[0] = OSSL_PARAM_construct_utf8_string(OSSL_MAC_PARAM_DIGEST,
+						      (char *) md_name, 0);
+	params[1] = OSSL_PARAM_construct_end();
+	if (EVP_MAC_init(ctx, key, key_len, params) != 1) {
+		EVP_MAC_CTX_free(ctx);
+		return NULL;
+	}
+	return ctx;
+}
+
