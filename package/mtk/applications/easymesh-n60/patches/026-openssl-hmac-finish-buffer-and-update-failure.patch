--- a/wappd/crypto/crypto_openssl.c
+++ b/wappd/crypto/crypto_openssl.c
@@ -1041,6 +1041,7 @@
 
 struct crypto_hash {
 	EVP_MAC_CTX *ctx;
+	int failed;
 };
 
 
@@ -1089,13 +1090,15 @@
 {
 	if (ctx == NULL)
 		return;
-	EVP_MAC_update(ctx->ctx, data, len);
+	if (EVP_MAC_update(ctx->ctx, data, len) != 1)
+		ctx->failed = 1;
 }
 
 
 int crypto_hash_finish(struct crypto_hash *ctx, u8 *mac, size_t *len)
 {
 	size_t mdlen = 0;
+	size_t required;
 	int res;
 
 	if (ctx == NULL)
@@ -1107,8 +1110,26 @@
 		return 0;
 	}
 
-	res = EVP_MAC_final(ctx->ctx, mac, &mdlen,
-			    EVP_MAC_CTX_get_mac_size(ctx->ctx));
+	if (ctx->failed) {
+		EVP_MAC_CTX_free(ctx->ctx);
+		bin_clear_free(ctx, sizeof(*ctx));
+		return -2;
+	}
+
+	required = EVP_MAC_CTX_get_mac_size(ctx->ctx);
+	if (required == 0) {
+		EVP_MAC_CTX_free(ctx->ctx);
+		bin_clear_free(ctx, sizeof(*ctx));
+		return -2;
+	}
+	if (*len < required) {
+		*len = required;
+		EVP_MAC_CTX_free(ctx->ctx);
+		bin_clear_free(ctx, sizeof(*ctx));
+		return -1;
+	}
+
+	res = EVP_MAC_final(ctx->ctx, mac, &mdlen, *len);
 	EVP_MAC_CTX_free(ctx->ctx);
 	bin_clear_free(ctx, sizeof(*ctx));
 
@@ -1117,7 +1138,7 @@
 		return 0;
 	}
 
-	return -1;
+	return -2;
 }
 
 
@@ -1137,8 +1158,12 @@
 	if (!ctx)
 		return -1;
 
-	for (i = 0; i < num_elem; i++)
-		EVP_MAC_update(ctx, addr[i], len[i]);
+	for (i = 0; i < num_elem; i++) {
+		if (EVP_MAC_update(ctx, addr[i], len[i]) != 1) {
+			EVP_MAC_CTX_free(ctx);
+			return -1;
+		}
+	}
 
 	res = EVP_MAC_final(ctx, mac, &out_len, mdlen);
 	EVP_MAC_CTX_free(ctx);
