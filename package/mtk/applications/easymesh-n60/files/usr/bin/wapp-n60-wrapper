#!/bin/sh
# N60 Pro WAPP startup: retain the known-good Action #338 lifecycle.
# The only added CLI selections are the WAPP binary's supported AP/WEXT modes.
# Do not pass unverified -f/-F/-u/-e/-w overrides: the vendor binary has its
# own WTS path (/etc/map/wts_bss_info_config) and default AP config discovery.

LOG_TAG="wapp-n60"
WAPP_LOG=/tmp/wapp-n60-startup.log

log_msg() {
    logger -t "$LOG_TAG" "$*"
}

# WAPP diagnostics can contain vendor BSS credentials. Keep the file private.
umask 077
: > "$WAPP_LOG"
chmod 600 "$WAPP_LOG"

# Match the previously successful N60 process lifecycle.
killall wapp 2>/dev/null || true
sleep 2

for iface in ra0 rax0; do
    if [ ! -d "/sys/class/net/$iface" ]; then
        log_msg "ERROR: required interface $iface is missing; WAPP not started"
        exit 1
    fi
done

if [ ! -s /etc/wapp_ap.conf ] ||
   ! grep -Fq '/etc/wapp_ap_ra0.conf' /etc/wapp_ap.conf ||
   ! grep -Fq '/etc/wapp_ap_rax0.conf' /etc/wapp_ap.conf; then
    log_msg "ERROR: /etc/wapp_ap.conf does not contain both N60 Pro band configs"
    exit 1
fi

# Keep the checked-in vendor WTS template unchanged. This is a validation
# only; WAPP and P1905 perform their own native WTS reads.
if [ ! -s /etc/map/wts_bss_info_config ] ||
   ! grep -qx '#ucc_bss_info' /etc/map/wts_bss_info_config ||
   [ "$(grep -c '^[0-9][0-9]*,ff:ff:ff:ff:ff:ff ' /etc/map/wts_bss_info_config)" -ne 12 ] ||
   ! grep -Fq 'Multi-AP-24G-2' /etc/map/wts_bss_info_config ||
   ! grep -Fq 'Multi-AP-5LG-2' /etc/map/wts_bss_info_config ||
   ! grep -Fq 'Multi-AP-5HG-2' /etc/map/wts_bss_info_config ||
   grep -Eq '(^| )13x |Multi-AP-6G-' /etc/map/wts_bss_info_config; then
    log_msg "ERROR: N60 WTS file does not contain the complete 12-record dual-band profile set"
    exit 1
fi

log_msg "Starting WAPP for ra0 and rax0 in OPMODE_AP / RA_WEXT; stdout/stderr: $WAPP_LOG"

# Action #338's proven foreground invocation, with explicit AP mode and
# WEXT IPC selections supported by this exact WAPP CLI ABI.
# Keep the daemon's original parent/child lifecycle attached to procd.
 /usr/bin/wapp -m OPMODE_AP -i RA_WEXT -d1 -v2 -cra0 -crax0 >> "$WAPP_LOG" 2>&1
wapp_rc=$?

# Some vendor builds daemonize after the parent exits. Keep procd attached
# until the complete WAPP process set exits.
while pidof wapp >/dev/null 2>&1; do
    sleep 2
done

log_msg "WAPP process set exited (rc=$wapp_rc); diagnostics: $WAPP_LOG"
exit "$wapp_rc"
