#!/bin/sh
# N60 Pro adaptation of MediaTek's WAPP startup model.
# WAPP is not considered ready until its expected control socket exists.

LOG_TAG="wapp-n60"

log_msg() {
    logger -t "$LOG_TAG" "$*"
}

killall wapp 2>/dev/null || true
sleep 2

for iface in ra0 rax0; do
    if [ ! -d "/sys/class/net/$iface" ]; then
        log_msg "ERROR: required interface $iface is missing; WAPP not started"
        exit 1
    fi
done

if [ ! -s /etc/wapp_ap.conf ] ||
   ! grep -Fq '/etc/wapp_ap_ra0.conf' /etc/wapp_ap.conf ||
   ! grep -Fq '/etc/wapp_ap_rax0.conf' /etc/wapp_ap.conf; then
    log_msg "ERROR: /etc/wapp_ap.conf does not contain both N60 Pro band configs"
    exit 1
fi

if [ ! -s /etc/map/wts_bss_info_config ] ||
   ! grep -qx '#ucc_bss_info' /etc/map/wts_bss_info_config ||
   [ "$(grep -c '^[0-9][0-9]*,ff:ff:ff:ff:ff:ff ' /etc/map/wts_bss_info_config)" -ne 16 ] ||
   ! grep -Fq 'Multi-AP-24G-2' /etc/map/wts_bss_info_config ||
   ! grep -Fq 'Multi-AP-5LG-2' /etc/map/wts_bss_info_config ||
   ! grep -Fq 'Multi-AP-5HG-2' /etc/map/wts_bss_info_config ||
   ! grep -Fq 'Multi-AP-6G-2' /etc/map/wts_bss_info_config; then
    log_msg "ERROR: vendor WTS file does not contain the complete 16-record EasyMesh test profile set"
    exit 1
fi

log_msg "Starting WAPP for ra0 and rax0"
/usr/bin/wapp -m OPMODE_AP -i RA_WEXT -d 1 -v 2 -f /etc/wapp_ap.conf -F /etc/map/mapd_cfg -u /etc/map/mapd_user.cfg -e br-lan -w br-lan -c ra0 -c rax0 &
wapp_pid=$!

# WAPP's own control/event endpoint is /tmp/wapp_server. A live PID alone
# does not prove interface registration or event-dispatch initialization.
waited=0
while { [ ! -S /tmp/wapp_server ] || [ ! -S /tmp/wapp_ctrl ]; } && [ "$waited" -lt 30 ]; do
    if ! kill -0 "$wapp_pid" 2>/dev/null && ! pidof wapp >/dev/null 2>&1; then
        break
    fi
    sleep 1
    waited=$((waited + 1))
done

if [ ! -S /tmp/wapp_server ] || [ ! -S /tmp/wapp_ctrl ]; then
    log_msg "ERROR: WAPP did not create both /tmp/wapp_server and /tmp/wapp_ctrl within 30 seconds"
    killall wapp 2>/dev/null || true
    wait "$wapp_pid" 2>/dev/null || true
    exit 1
fi

log_msg "WAPP event socket and control socket ready: /tmp/wapp_server /tmp/wapp_ctrl"

# Verify both wireless interfaces are registered with WAPP before MAPD/P1905.
# drv_version is a read-only WAPP control command.
ra_version="$(/usr/bin/wappctrl ra0 drv_version 2>&1)" || {
    log_msg "ERROR: WAPP driver registration check failed on ra0: $ra_version"
    killall wapp 2>/dev/null || true
    wait "$wapp_pid" 2>/dev/null || true
    exit 1
}
rax_version="$(/usr/bin/wappctrl rax0 drv_version 2>&1)" || {
    log_msg "ERROR: WAPP driver registration check failed on rax0: $rax_version"
    killall wapp 2>/dev/null || true
    wait "$wapp_pid" 2>/dev/null || true
    exit 1
}
log_msg "WAPP driver versions: ra0=$ra_version; rax0=$rax_version"

# Apply the vendor WAPP MBO defaults on both radios. This is the same
# v3.0.2.0 command used by the vendor startup reference; it is required for
# the MBO/11v request path and is safe to run after WAPP's control socket exists.
if ! /usr/bin/wappctrl ra0 mbo reset_default >/dev/null 2>&1 ||
   ! /usr/bin/wappctrl rax0 mbo reset_default >/dev/null 2>&1; then
    log_msg "ERROR: WAPP MBO default initialization failed on ra0/rax0"
    killall wapp 2>/dev/null || true
    wait "$wapp_pid" 2>/dev/null || true
    exit 1
fi
log_msg "WAPP driver registration and MBO defaults initialized on both radios"

wapp_rc=0
wait "$wapp_pid" || wapp_rc=$?
# Some vendor builds daemonize after the parent exits; keep procd attached
# until the complete WAPP process set exits.
while pidof wapp >/dev/null 2>&1; do
    sleep 2
done

log_msg "WAPP process set exited (rc=$wapp_rc)"
exit "$wapp_rc"
