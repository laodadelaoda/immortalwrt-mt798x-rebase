#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
    # Preserve the existing boot-time wait for MTK Wi-Fi driver readiness.
    sleep 60

    # GL 7.6.7.3 p1905_managerd expects this unversioned library name.
    if [ -f /usr/lib/libnl-tiny.so.1 ] && [ ! -e /usr/lib/libnl-tiny.so ]; then
        ln -sf /usr/lib/libnl-tiny.so.1 /usr/lib/libnl-tiny.so
    fi

    modprobe mapfilter 2>/dev/null

    procd_open_instance wapp
    procd_set_param command /usr/bin/wapp -d1 -v2 -cra0 -crax0
    procd_set_param respawn
    procd_close_instance

    sleep 2

    procd_open_instance p1905
    procd_set_param command /bin/sh -c '
        role=$(grep "^map_root=" /etc/map/1905d.cfg | cut -d= -f2)
        if [ "$role" = "1" ]; then
            exec /usr/bin/p1905_managerd -r0 -f /etc/map/1905d.cfg -F /etc/map/wts_bss_info_config
        else
            exec /usr/bin/p1905_managerd -r1 -f /etc/map/1905d.cfg -F /etc/map/wts_bss_info_config
        fi
    '
    procd_set_param respawn
    procd_close_instance

    sleep 2

    procd_open_instance mapd
    procd_set_param command /usr/bin/mapd -I /etc/map/mapd_cfg -O /etc/mapd_strng.conf
    procd_set_param respawn
    procd_close_instance
}

stop_service() {
    killall mapd 2>/dev/null
    killall p1905_managerd 2>/dev/null
    killall wapp 2>/dev/null
}
