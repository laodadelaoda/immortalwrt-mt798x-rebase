#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

radio_is_ready() {
    iface="$1"
    info="$(iwconfig "$iface" 2>/dev/null)" || return 1
    printf '%s\n' "$info" | grep -q 'Mode:Master' &&
        printf '%s\n' "$info" | grep -Eq 'ESSID:"[^"]+"'
}

# Match the MTK 7.6.7.3 EasyMesh R3 startup sequence. The driver defaults
# bMapR3Enable, bDppEnable and bTSEnable to disabled; MapMode=1 alone does
# not enable the R3/R2 driver data path.
apply_map_r3_driver_config() {
    iface="$1"
    for setting in mapR3Enable=1 DppEnable=1 mapTSEnable=1 cp_support=1; do
        output="$(iwpriv "$iface" set "$setting" 2>&1)"
        rc=$?
        if [ "$rc" -ne 0 ] ||
           printf '%s\n' "$output" | grep -qiE 'invalid argument|operation not supported|not supported|no such device'; then
            logger -t easymesh "ERROR: iwpriv $iface set $setting failed (rc=$rc): $output"
            return 1
        fi
        logger -t easymesh "Applied $setting on $iface"
    done
}

start_service() {
    # Wait for both radios to finish AP setup, not merely for netdev creation.
    # Require three consecutive ready samples to avoid racing mtwifi-cfg startup.
    waited=0
    stable=0
    while [ "$waited" -lt 120 ]; do
        if radio_is_ready ra0 && radio_is_ready rax0; then
            stable=$((stable + 1))
        else
            stable=0
        fi
        [ "$stable" -ge 3 ] && break
        sleep 5
        waited=$((waited + 5))
    done
    if [ "$stable" -lt 3 ]; then
        logger -t easymesh "ERROR: ra0/rax0 did not reach stable AP mode within 120 seconds"
        return 1
    fi

    # Use the checked-in N60-supported vendor WTS template unchanged.
    if [ ! -s /etc/map/wts_bss_info_config ] ||
       ! grep -qx '#ucc_bss_info' /etc/map/wts_bss_info_config ||
       [ "$(grep -c '^[0-9][0-9]*,ff:ff:ff:ff:ff:ff ' /etc/map/wts_bss_info_config)" -ne 12 ]; then
        logger -t easymesh "ERROR: N60 WTS template is missing or incomplete; refusing to start EasyMesh"
        return 1
    fi

    # This N60 package is fixed to MAP R3. Do not start a mixed R2/R3
    # configuration if the runtime P1905 role/version file was replaced.
    if ! grep -qx 'map_ver=R3' /etc/map/1905d.cfg; then
        logger -t easymesh "ERROR: /etc/map/1905d.cfg must select map_ver=R3"
        return 1
    fi

    # Check the exact SONAMEs required by the shipped WAPP/P1905 ELF files.
    for lib in /usr/lib/libkvcutil.so.1 /usr/lib/libeth_1905ops.so \
               /usr/lib/libnl-tiny.so.1 /usr/lib/libssl.so.1.1 /usr/lib/libcrypto.so.1.1; do
        if [ ! -s "$lib" ]; then
            logger -t easymesh "ERROR: required EasyMesh runtime library is missing: $lib"
            return 1
        fi
    done

    # GL 7.6.7.3 p1905_managerd expects this unversioned link as well.
    if [ ! -e /usr/lib/libnl-tiny.so ]; then
        ln -sf /usr/lib/libnl-tiny.so.1 /usr/lib/libnl-tiny.so
    fi
    if [ ! -e /usr/lib/libnl-tiny.so ]; then
        logger -t easymesh "ERROR: failed to create /usr/lib/libnl-tiny.so compatibility link"
        return 1
    fi

    if ! modprobe mapfilter 2>/dev/null; then
        logger -t easymesh "ERROR: mapfilter kernel module failed to load; refusing to start P1905"
        return 1
    fi

    # Enable the same MAP R3 driver features as MTK's EasyMesh_openwrt.sh
    # before WAPP attaches: MAP R3 also enables the MAP R2 driver flag.
    if ! command -v iwpriv >/dev/null 2>&1; then
        logger -t easymesh "ERROR: iwpriv is unavailable; cannot enable MTK MAP R3"
        return 1
    fi
    if ! apply_map_r3_driver_config ra0 || ! apply_map_r3_driver_config rax0; then
        logger -t easymesh "ERROR: MTK MAP R3 driver initialization failed; WAPP/P1905/MAPD will not start"
        return 1
    fi

    # Match Action #338: do not add procd respawn to the WAPP wrapper.
    # The wrapper remains attached to the vendor daemon's parent/child lifetime.
    procd_open_instance wapp
    procd_set_param command /usr/bin/wapp-n60-wrapper
    procd_close_instance

    sleep 2

    # P1905 starts only after WAPP has created both real Unix sockets.
    procd_open_instance p1905
    procd_set_param command /bin/sh -c '
        waited=0
        while { [ ! -S /tmp/wapp_server ] || [ ! -S /tmp/wapp_ctrl ]; } && [ "$waited" -lt 30 ]; do
            sleep 1
            waited=$((waited + 1))
        done
        if [ ! -S /tmp/wapp_server ] || [ ! -S /tmp/wapp_ctrl ]; then
            logger -t easymesh "ERROR: WAPP event/control sockets are not ready; P1905 will not start"
            exit 1
        fi
        role=$(grep "^map_root=" /etc/map/1905d.cfg | cut -d= -f2)
        if [ "$role" = "1" ]; then
            exec /usr/bin/p1905_managerd -r0 -f /etc/map/1905d.cfg -F /etc/map/wts_bss_info_config
        else
            exec /usr/bin/p1905_managerd -r1 -f /etc/map/1905d.cfg -F /etc/map/wts_bss_info_config
        fi
    '
    procd_set_param respawn
    procd_close_instance

    sleep 2

    # Generate only /etc/mapd_strng.conf from existing N60 Pro settings.
    # Do not run the upstream uci2map.lua converter, which rewrites other
    # MAPD/P1905 files and depends on a separate /etc/config/mapd layout.
    procd_open_instance mapd
    procd_set_param command /bin/sh -c '
        /usr/sbin/generate-mapd-strng || exit 1
        exec /usr/bin/mapd -I /etc/map/mapd_cfg -O /etc/mapd_strng.conf
    '
    procd_set_param respawn
    procd_close_instance
}

stop_service() {
    killall mapd 2>/dev/null
    killall p1905_managerd 2>/dev/null
    killall wapp 2>/dev/null
}
